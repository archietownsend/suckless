#!/bin/bash

case $BLOCK_BUTTON in
          1) setsid -f st -e sh -c "yes | yay && kill -45 $(pidof dwmblocks)" ;;
          6) setsid -f st -e nvim "$0" ;;
esac

# checkupdates (pacman-contrib) syncs a temporary copy of the database, so the
# real one is never touched. Falls back to yay -Qu if it isn't installed.
countupdates() {
	if command -v checkupdates >/dev/null; then
		{ checkupdates; yay -Qua; } 2>/dev/null | wc -l
	else
		yay -Qu 2>/dev/null | wc -l
	fi
}

echo "$(countupdates)  "
