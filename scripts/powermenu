#!/bin/sh
case "$(printf "Shutdown\nRestart\nLogout\nSuspend\nLock\n" | dmenu \
    -i -p  \
    "Power menu:" -l 5)" in
        Shutdown) exec systemctl poweroff;;
        Restart) exec systemctl reboot;;
        Logout) kill $(ps -o ppid= -C dwm); killall dwm;;
        Suspend) exec systemctl suspend;;
        Lock) exec slock;;
esac
